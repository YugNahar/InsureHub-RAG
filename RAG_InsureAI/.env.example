# ─────────────────────────────────────────────────────────────────────────────
# InsureHub RAG — environment variables
# Copy this file to .env and fill in the values before running docker compose.
# NEVER commit .env to git — it contains secrets.
# ─────────────────────────────────────────────────────────────────────────────


# ── LLM backend (vLLM) ───────────────────────────────────────────────────────
# URL of your vLLM server (no trailing slash).
# Example: http://your-server-ip:8000
VLLM_HOST=http://your-vllm-host:8000

# Model name as registered in vLLM (must match --served-model-name).
# Example: Qwen/Qwen2.5-7B-Instruct
VLLM_MODEL=Qwen/Qwen2.5-7B-Instruct

# API key for vLLM (leave blank if your server has no auth).
VLLM_API_KEY=

# Max tokens the LLM generates per response.
VLLM_MAX_TOKENS=1024


# ── Admin credentials ────────────────────────────────────────────────────────
# Username shown on the admin login page.
ADMIN_USERNAME=admin

# Password for the admin panel.
ADMIN_PASSWORD=change-me

# Password for the super-admin panel (can delete agents across all views).
SUPER_ADMIN_PASSWORD=change-me-super

# Password human agents use to log into the agent dashboard.
# If not set, falls back to ADMIN_PASSWORD.
AGENT_PASSWORD=change-me-agent

# TEMPORARY: admin/agent login is currently OFF BY DEFAULT (unset = disabled)
# so the app works with zero .env setup during early testing. Anyone who can
# reach the server can upload/delete documents and clear the cache with no
# password. Set this to false explicitly before real users can reach this
# deployment.
DISABLE_AUTH=true


# ── Auth / JWT ───────────────────────────────────────────────────────────────
# Secret used to sign JWT tokens — generate a strong random string.
# Example: openssl rand -hex 32
AUTH_SECRET_KEY=change-me-use-a-long-random-string

# How long login sessions last (minutes). Default: 480 (8 hours).
AUTH_TOKEN_EXPIRE_MINUTES=480


# ── Email / agent handoff ────────────────────────────────────────────────────
# All of this is also editable live from Super Admin > Settings >
# "Escalation Email Sender" (2026-08-14) — a panel save there takes effect
# on the very next email with no restart, and takes priority over these env
# vars. These are just the fallback used until an admin has saved a value
# in the panel at least once, so a fresh install isn't silently mute.
#
# Which provider to use: "gmail" or "outlook". Defaults to "gmail" if unset.
EMAIL_PROVIDER=gmail

# Gmail address that sends handoff notification emails.
GMAIL_SENDER=your-gmail@gmail.com

# Gmail App Password (NOT your account password).
# Generate one at: https://myaccount.google.com/apppasswords
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Outlook/Office 365 equivalents, only needed if EMAIL_PROVIDER=outlook.
# App Password generated at: https://account.live.com/proofs/AppPassword
# (or your Microsoft 365 admin's app-password page for a work account —
# note some tenants have SMTP AUTH disabled by default; an admin may need
# to re-enable it for this mailbox first).
OUTLOOK_SENDER=your-outlook@outlook.com
OUTLOOK_APP_PASSWORD=xxxxxxxxxxxxxxxx

# Email address of the default agent who receives handoff notifications.
# Only used as a fallback on first-time setup, before app/agent_emails.xlsx
# exists — see below.
AGENT_EMAIL=agent@example.com

# Every escalation email is sent to every address listed in this Excel file
# (one email per row, under an "email" header in the first sheet — row 1 is
# the header and is skipped). Add or remove a row to change who's notified;
# the file is re-read from disk on every send, no restart needed. Not
# committed to git (same as this .env file) since it holds real addresses —
# create it locally at the default path below, or point AGENT_EMAILS_FILE
# elsewhere.
# AGENT_EMAILS_FILE=/app/app/agent_emails.xlsx


# ── Embedding model ──────────────────────────────────────────────────────────
# Sentence-transformer model used for vector embeddings and semantic search.
# Change only if you want a different embedding model (requires re-ingesting all docs).
EMBED_MODEL=BAAI/bge-base-en-v1.5


# ── Vector store collection names ────────────────────────────────────────────
# Chroma collection names — only change if you need multiple isolated deployments.
TVEC_DOCS_COLLECTION=insurance_docs
TVEC_SUMMARIES_COLLECTION=insurance_summaries
TVEC_VIDEOS_COLLECTION=insurance_videos
TVEC_WEBPAGES_COLLECTION=insurance_webpages


# ── KV answer cache ──────────────────────────────────────────────────────────
# How long cached answers are valid (seconds). Default: 3600 (1 hour).
KV_CACHE_TTL=3600

# Maximum number of cached entries before LRU eviction kicks in.
KV_CACHE_MAX_ENTRIES=500

# Cosine similarity threshold for semantic cache hits (0–1). Default: 0.92.
SEMANTIC_CACHE_THRESHOLD=0.92


# ── Retrieval tuning ─────────────────────────────────────────────────────────
# BGE reranker score gate — queries whose best chunk scores below this are
# refused without calling the LLM. Scores are sigmoid-bounded probabilities
# in [0,1], but measured to NOT reliably separate good from bad content —
# legitimate questions ("no claim bonus") can score as low as 0.002, below
# actual weak matches (~0.06). Keep this near-zero (backstop against pure
# noise only); real grounding defense is the content-based coverage checks,
# not this score. Default: 0.0005.
RERANK_GATE_THRESHOLD=0.0005


# ── Optional: alternative LLM backends ──────────────────────────────────────
# Uncomment and fill in if you want to use OpenAI or Anthropic instead of vLLM.
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# ── Optional: Groq ────────────────────────────────────────────────────────────
# GROQ_API_KEY, once set, powers two independent things:
#   1. Ava's live chat + structured extraction (travel_bot/services/
#      llm_service.py) — always uses Groq when this key is present.
#   2. Classification (metadata_tagger.py's ingestion tagging +
#      multi_source_rag.py's query-time classification/extraction calls,
#      see router.py's get_classification_llm()) — same, independent of
#      FORCE_BACKEND below.
# Layla's main RAG-answer generation is the one thing that stays on vLLM
# unless FORCE_BACKEND=groq is explicitly set (opt-in test only, e.g.
# checking whether a bigger model reduces generation-fidelity fabrication
# vs. the current vLLM model) — unset it (or set it to anything else) and
# vLLM is active again immediately, VLLM_HOST/VLLM_MODEL untouched either way.
#
# GROQ_MODEL's old default (llama-3.3-70b-versatile) was deprecated by
# Groq, shutdown date 2026-08-16 — both GROQ_MODEL and
# GROQ_CLASSIFICATION_MODEL now default to openai/gpt-oss-120b, Groq's
# recommended replacement. It's a REASONING model, unlike the old one —
# confirmed live it still works correctly for both classification and
# Ava's structured (function-calling) extraction, but only with
# reasoning_effort set and enough max_tokens headroom for reasoning
# tokens on top of the actual output (both handled automatically in code,
# nothing to configure beyond GROQ_CLASSIFICATION_REASONING_EFFORT below
# if you want a different effort level).
# GROQ_API_KEY=gsk_...
# GROQ_MODEL=openai/gpt-oss-120b
# FORCE_BACKEND=groq
# GROQ_CLASSIFICATION_MODEL=openai/gpt-oss-120b
# GROQ_CLASSIFICATION_REASONING_EFFORT=low
